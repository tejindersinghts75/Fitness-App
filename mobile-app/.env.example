EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Optional mobile deep-link destinations. Both must be allowed in Supabase Auth URL Configuration.
EXPO_PUBLIC_EMAIL_CONFIRMATION_URL=fitora://auth/confirmed
# Optional. Use a website reset page later, or a mobile deep link now.
EXPO_PUBLIC_PASSWORD_RESET_URL=fitora://auth/reset-password
