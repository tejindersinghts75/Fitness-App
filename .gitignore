# env files (can opt-in for committing if needed)
.env
.env.local
.env.*.local
!.env.example

# vercel
.vercel

**/dist/
/.wrangler/
/outputs/
/work/

# native build output
mobile-app/ios/Pods/
mobile-app/ios/build/
mobile-app/android/.gradle/
mobile-app/android/app/build/
mobile-app/android/build/

